{
  "permissions": {
    "allow": [
      "Bash(npx -y @anthropic-ai/mcp-server-fetch --version)",
      "Bash(uvx mcp-server-fetch:*)",
      "mcp__lean-ctx__ctx_shell"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/trembiasz/.cargo/bin/lean-ctx.exe hook observe"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/trembiasz/.cargo/bin/lean-ctx.exe hook observe"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|bash|PowerShell|powershell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/trembiasz/.cargo/bin/lean-ctx.exe hook rewrite"
          }
        ]
      },
      {
        "matcher": "Read|read|ReadFile|read_file|View|view|Grep|grep|Search|search|ListFiles|list_files|ListDirectory|list_directory",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/trembiasz/.cargo/bin/lean-ctx.exe hook redirect"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/trembiasz/.cargo/bin/lean-ctx.exe hook observe"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/trembiasz/.cargo/bin/lean-ctx.exe hook observe"
          }
        ]
      }
    ]
  }
}
